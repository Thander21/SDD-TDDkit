{
    "permissions":  {
                        "deny":  [
                                     "Read(//**/.env)",
                                     "Read(//**/.env.*)",
                                     "Read(//**/.env.*.local)",
                                     "Read(//**/.env.local)",
                                     "Read(//**/*id_rsa*)",
                                     "Read(//**/*id_ed25519*)",
                                     "Read(//**/*.pem)",
                                     "Read(//**/*.key)",
                                     "Read(//**/*.pfx)",
                                     "Read(//**/*.p12)",
                                     "Read(//**/*credential*)",
                                     "Read(//**/*secret*)",
                                     "Read(//**/*token*)",
                                     "Read(//**/*.kdbx)",
                                     "Edit(//**/.env)",
                                     "Edit(//**/.env.*)",
                                     "Edit(//**/.env.*.local)",
                                     "Edit(//**/.env.local)",
                                     "Edit(//**/*id_rsa*)",
                                     "Edit(//**/*id_ed25519*)",
                                     "Edit(//**/*.pem)",
                                     "Edit(//**/*.key)",
                                     "Edit(//**/*.pfx)",
                                     "Edit(//**/*.p12)",
                                     "Edit(//**/*credential*)",
                                     "Edit(//**/*secret*)",
                                     "Edit(//**/*token*)",
                                     "Edit(//**/*.kdbx)",
                                     "Write(//**/.env)",
                                     "Write(//**/.env.*)",
                                     "Write(//**/.env.*.local)",
                                     "Write(//**/.env.local)",
                                     "Write(//**/*id_rsa*)",
                                     "Write(//**/*id_ed25519*)",
                                     "Write(//**/*.pem)",
                                     "Write(//**/*.key)",
                                     "Write(//**/*.pfx)",
                                     "Write(//**/*.p12)",
                                     "Write(//**/*credential*)",
                                     "Write(//**/*secret*)",
                                     "Write(//**/*token*)",
                                     "Write(//**/*.kdbx)"
                                 ],
                        "ask":  [
                                    "Bash(git push *)",
                                    "Bash(git commit *)",
                                    "PowerShell(git push *)",
                                    "PowerShell(git commit *)"
                                ]
                    },
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash|PowerShell",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell.exe",
                                                           "args":  [
                                                                        "-NoProfile",
                                                                        "-ExecutionPolicy",
                                                                        "Bypass",
                                                                        "-File",
                                                                        "${CLAUDE_PROJECT_DIR}/tools/sdd/guard.ps1",
                                                                        "-Platform",
                                                                        "Claude"
                                                                    ],
                                                           "timeout":  15,
                                                           "onFailure":  "block"
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Write|Edit|NotebookEdit",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell.exe",
                                                           "args":  [
                                                                        "-NoProfile",
                                                                        "-ExecutionPolicy",
                                                                        "Bypass",
                                                                        "-File",
                                                                        "${CLAUDE_PROJECT_DIR}/tools/sdd/edit_guard.ps1",
                                                                        "-Platform",
                                                                        "Claude"
                                                                    ],
                                                           "timeout":  15,
                                                           "onFailure":  "block"
                                                       }
                                                   ]
                                     }
                                 ]
              }
}